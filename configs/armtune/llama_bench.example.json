{
  "schema_version": "1.0",
  "result_origin": "measured",
  "target": {
    "type": "ssh",
    "host": "<arm-linux-hostname>",
    "user": "<ssh-user>",
    "port": 22,
    "identity_file": "<ssh-identity-file-path-outside-repo>",
    "remote_python": "python3",
    "remote_module": "autotune.cli",
    "remote_workdir": "<remote-armtune-workdir>",
    "strict_host_key_checking": true
  },
  "executable": {
    "path": "/<remote-llama-bench-binary>",
    "expected_sha256": null
  },
  "model": {
    "path": "/<remote-gguf-model-file>",
    "expected_sha256": null
  },
  "benchmark": {
    "threads": 8,
    "prompt_tokens": 128,
    "generation_tokens": 64,
    "repetitions": 1,
    "timeout_seconds": 120,
    "additional_supported_options": {}
  },
  "artifacts": {
    "preserve_raw_stdout": true,
    "preserve_raw_stderr": true
  }
}
