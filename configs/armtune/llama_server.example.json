{
  "schema_version": "1.0",
  "result_origin": "measured",
  "target": {
    "type": "ssh",
    "host": "<arm64-hostname>",
    "user": "<ssh-user>",
    "remote_workdir": "~/armtune-runs",
    "strict_host_key_checking": true
  },
  "runtime": {
    "adapter": "llama_server"
  },
  "executable": {
    "path": "/absolute/path/to/llama-server",
    "expected_sha256": "<optional-64-character-sha256>"
  },
  "model": {
    "path": "/absolute/path/to/model.gguf",
    "expected_sha256": "<optional-64-character-sha256>"
  },
  "server": {
    "host": "127.0.0.1",
    "port": "auto",
    "startup_timeout_seconds": 30,
    "request_timeout_seconds": 30,
    "shutdown_timeout_seconds": 5,
    "threads": 2,
    "context_size": 512,
    "batch_size": 128,
    "seed": 42,
    "temperature": 0.0
  },
  "workload": {
    "mode": "server",
    "prompt_suite_path": "/absolute/path/to/public_prompt_suite.json",
    "predict_tokens": 64,
    "repetitions": 3,
    "warmup_requests": 1,
    "streaming": true,
    "cooldown_seconds": 0
  },
  "artifacts": {
    "preserve_server_stdout": true,
    "preserve_server_stderr": true,
    "preserve_request_stream": true,
    "preserve_generated_output": true
  }
}
