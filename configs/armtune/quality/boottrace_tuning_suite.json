{
  "schema_version": "1.0",
  "suite_id": "synthetic_boottrace_tuning_v1",
  "description": "Public deterministic BootTrace tuning quality gate. These cases are direct key-value extraction checks for quality-preserving performance tuning, not the harder capability benchmark.",
  "cases": [
    {
      "case_id": "tuning_successful_boot",
      "category": "boottrace_tuning_success",
      "prompt": "CASE_ID=tuning_successful_boot\nYou are validating a deterministic synthetic BootTrace tuning case.\nEVIDENCE_LINE_IDS=L101,L102,L103,L104\nTrace lines:\nL101 STATUS=success\nL102 FAILURE_STAGE=none\nL103 ROOT_CAUSE=none\nL104 BOOT_RESULT=OS_HANDOFF_COMPLETE\nReturn exactly one JSON object. Use only these fields: case_id, status, failure_stage, root_cause_category, evidence_line_ids. Copy values only from explicit trace fields. Copy EVIDENCE_LINE_IDS exactly as the evidence_line_ids array. Use unknown when required fields are absent. Never invent evidence IDs.",
      "response_format": "json",
      "required": true,
      "maximum_predicted_tokens": 128,
      "generation_settings": {
        "temperature": 0.0,
        "seed": 42
      },
      "expected": {
        "case_id": "tuning_successful_boot",
        "status": "success",
        "failure_stage": "none",
        "root_cause_category": "none",
        "required_evidence_line_ids": ["L101", "L102", "L103", "L104"],
        "allowed_evidence_line_ids": ["L101", "L102", "L103", "L104"]
      },
      "validators": [
        {"type": "nonempty_output"},
        {"type": "valid_json"},
        {
          "type": "json_schema",
          "expected": {
            "required": ["case_id", "status", "failure_stage", "root_cause_category", "evidence_line_ids"],
            "properties": {
              "case_id": {"type": "string"},
              "status": {"type": "string"},
              "failure_stage": {"type": "string"},
              "root_cause_category": {"type": "string"},
              "evidence_line_ids": {"type": "array"}
            }
          }
        },
        {"type": "exact_field", "field": "case_id", "expected": "tuning_successful_boot"},
        {"type": "allowed_values", "field": "status", "expected": ["success", "warning", "failure", "unknown"]},
        {"type": "exact_field", "field": "status", "expected": "success"},
        {"type": "allowed_values", "field": "failure_stage", "expected": ["none", "device_initialization", "boot_selection", "firmware_validation", "network_initialization", "evidence_collection"]},
        {"type": "exact_field", "field": "failure_stage", "expected": "none"},
        {"type": "allowed_values", "field": "root_cause_category", "expected": ["none", "recoverable_device_warning", "device_initialization_timeout", "boot_device_missing", "firmware_component_failure", "insufficient_evidence"]},
        {"type": "exact_field", "field": "root_cause_category", "expected": "none"},
        {
          "type": "evidence_line_ids",
          "field": "evidence_line_ids",
          "expected": {
            "allowed": ["L101", "L102", "L103", "L104"],
            "required": ["L101", "L102", "L103", "L104"]
          }
        }
      ]
    },
