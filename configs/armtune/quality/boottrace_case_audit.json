      "unknown_policy_correctness": "not_applicable_trace_is_sufficient",
      "ambiguity": "none",
      "canonical_answer_change_required": false,
      "human_rationale": "The trace reaches userspace after BL1 and BL2 handoff, so success is the only supported status. All three lines are needed to prove the ordered boot path."
