{
  "schema_version": "1.0",
  "suite_id": "synthetic_boottrace_quality_v1",
  "description": "Public synthetic BootTrace quality suite for deterministic ArmTune server tuning validation.",
  "cases": [
    {
      "case_id": "boot_success",
      "category": "boottrace_success",
      "prompt": "CASE_ID=boot_success\nYou are validating this synthetic BootTrace excerpt.\nL001 Boot ROM entered BL1\nL002 BL2 loaded kernel image\nL003 Kernel handed off to userspace\nReturn raw compact JSON only; do not wrap it in Markdown fences. Use status exactly as success, warning, failure, or unknown. Include case_id, status, event_sequence_valid, latency_ms, summary, and evidence_line_ids.",
      "response_format": "json",
      "required": true,
      "maximum_predicted_tokens": 96,
      "generation_settings": {
        "temperature": 0.0,
        "seed": 42
      },
      "expected": {
        "case_id": "boot_success",
        "status": "success",
        "required_evidence_line_ids": ["L001", "L002", "L003"],
        "allowed_evidence_line_ids": ["L001", "L002", "L003"]
      },
      "validators": [
        {"type": "nonempty_output"},
        {"type": "valid_json"},
        {
          "type": "json_schema",
          "expected": {
            "required": ["case_id", "status", "event_sequence_valid", "latency_ms", "summary", "evidence_line_ids"],
            "properties": {
              "case_id": {"type": "string"},
              "status": {"type": "string"},
              "event_sequence_valid": {"type": "boolean"},
              "latency_ms": {"type": "number"},
              "summary": {"type": "string"},
              "evidence_line_ids": {"type": "array"}
            }
          }
        },
        {"type": "exact_field", "field": "case_id", "expected": "boot_success"},
        {"type": "allowed_values", "field": "status", "expected": ["success"]},
        {"type": "exact_field", "field": "event_sequence_valid", "expected": true},
        {"type": "numeric_range", "field": "latency_ms", "expected": {"min": 0, "max": 120}},
        {"type": "required_substrings", "field": "summary", "expected": ["Boot completed"]},
        {"type": "forbidden_substrings", "field": "summary", "expected": ["invented", "hallucinated", "unknown line"]},
        {"type": "regex", "field": "summary", "expected": "Boot completed successfully"},
        {
          "type": "evidence_line_ids",
          "field": "evidence_line_ids",
          "expected": {
            "allowed": ["L001", "L002", "L003"],
            "required": ["L001", "L002", "L003"]
          }
        }
      ]
    },
